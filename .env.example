# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Usar la publishable key (sb_publishable_...) o la legacy anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Secret key (sb_secret_...) o legacy service_role key (eyJ...)
# Solo para server-side / admin tasks
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key

# Base URL del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (Fase Monetización)
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_WEBHOOK_SECRET=your-webhook-secret

